from __gin__ import dynamic_registration

import after
from after import diffusion
import after.diffusion.model
import after.diffusion.networks.transformerv3

IN_SIZE = None
N_SIGNAL = None

ZS_CHANNELS = 64
ZT_CHANNELS = 6

SR = 48000
STRUCTURE_TYPE = "midi"
MAX_STEPS = 1000000
SHUFFLE = None

LOCAL_ATTENTION_SIZE = 8
ATTENTION_CHUNK_SIZE = 1

# Data
diffusion.utils.get_datasets:
    db_list = None
    emb_model_path = None

diffusion.utils.collate_fn:
    n_signal = %N_SIGNAL
    structure_type = %STRUCTURE_TYPE
    compress_tc = 8
    shift_tc = 0

### ARCHITECTURE ### 
diffusion.networks.LinearEncoder:
    channels=[512, 1024, 1024, 256, %ZT_CHANNELS]
    drop_out=0.15
    use_tanh=False
    regularisation="sigreg"


encoder_time/diffusion.networks.Encoder1D:
    in_size = 128
    channels = [128, 128, 128, %ZS_CHANNELS]
    ratios = [2, 2, 2]
    ac_regularisation = False
    norm_type = "none"
    causal=True

diffusion.networks.transformerv3.DenoiserV3:
    n_channels = %IN_SIZE
    embed_dim = 384
    cond_dim = %ZT_CHANNELS
    noise_embed_dims = 64
    n_layers = 6
    mlp_multiplier = 3
    dropout  = 0.0
    causal = True
    tcond_dim = %ZS_CHANNELS
    local_attention_size = %LOCAL_ATTENTION_SIZE
    meanflow = True
    guidance_embed = True
    num_heads = 8


diffusion.model.Base:
    sr = %SR
    net= @diffusion.networks.transformerv3.DenoiserV3()
    encoder = None  # Supplied by --ssl_config / --ssl_checkpoint.
    encoder_time = @encoder_time/diffusion.networks.Encoder1D()    
    post_encoder = @diffusion.networks.LinearEncoder
    time_transform = None
    drop_value = -4.
    drop_rate = 0.3

 
diffusion.model.Base.fit: 
    max_steps = %MAX_STEPS

    ## Adversarial
    timbre_warmup = 0
    adversarial_weight = 0.
    adversarial_warmup = 1

    drop_targets = [0]

    # Noise augmentation to smooth the latent space
    timbre_noise_aug = 0.1
    structure_noise_aug = 0.

    ## Encoder regularisation
    regularisation_weight_cond = 0.0002
    regularisation_weight_time_cond = 1


    ## Log ## 
    steps_valid = 10000
    steps_save = 50000
    lr = 1e-4


# MIDI starts at codec_hop / 4 (256 samples for a 1024-hop codec).
# encoder_time ratios [1, 2, 2] bring it to the diffusion/codec rate.
diffusion.model.build_diffusion.model = @diffusion.model.MeanFlow

# Guidance is learned into the interval field; its reference keeps timbre.
diffusion.model.MeanFlow:
    fm_fraction = 0.5
    dde_eps = 0.002
    guidance_enabled = True
    guidance_omega_max = 8.0
    guidance_t_max = 0.8
    guidance_apg_eta = 0.0
    guidance_apg_r = 0.15
